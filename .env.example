# Local development only. Copy to .env if you want a reminder, but the
# processes do not load .env files. Export the variables in the shell
# that starts each app. Do not source this file into both shells:
# the API and the web server each read PORT.
#
# These values are intentionally weak and local. Do not copy them into
# Compose, an image, or a workflow.
#
# Compose (Task 3): export real passwords in the shell before
# `docker compose up --build`. Use placeholders here only.
#
# export POSTGRES_PASSWORD=replace-with-a-strong-password
# export VALKEY_PASSWORD=replace-with-a-strong-password

# API
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/devops_task
VALKEY_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=30
CORS_ORIGIN=http://127.0.0.1:3000

# Web (second shell)
# HOST=0.0.0.0
# PORT=3000
API_UPSTREAM=http://127.0.0.1:3001

# Compose stack passwords (required for docker compose up)
POSTGRES_PASSWORD=replace-with-a-strong-password
VALKEY_PASSWORD=replace-with-a-strong-password
